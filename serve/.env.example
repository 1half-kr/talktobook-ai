# 운영 .env는 .github/workflows/deploy-ai.yml이 GitHub Secrets로 생성한다.
# 이 파일은 같은 키 구조의 로컬 개발용 예시다. (cp serve/.env.example serve/.env)
#
# 주의: main.py가 load_dotenv()보다 SQS consumer를 먼저 import한다.
#       consumer까지 띄우려면 셸에 export 후 실행한다. (set -a; source .env; set +a)

# 1. 로그
DEBUG=True
LOG_LEVEL=DEBUG
# 기본값 /var/log/ai-server는 로컬(macOS)에서 권한 문제로 실패하므로 로컬은 상대 경로를 쓴다
LOG_DIR=./logs

# 2. OpenAI
# sk-로 시작하면 OpenAI, 아니면 Azure OpenAI connection을 만든다 (운영은 OpenAI 키)
AZURE_OPENAI_API_KEY=your-openai-api-key
# Azure OpenAI를 쓸 때만 필요
# AZURE_OPENAI_API_BASE=https://your-api-base.openai.azure.com
# AZURE_OPENAI_API_VERSION=2023-07-01-preview

# 3. JWT (backend jwt.key와 같은 값. 로컬 개발용 값)
LIFE_BOOKSHELF_AI_JWT_SECRET_KEY=0190ab45-7e42-7a3f-9dec-726ddf778076

# 4. CORS 허용 Origin (localhost:5173은 코드에서 기본 허용)
WEB_URL=http://localhost:5173

# 5. Redis (로컬: docker run -d -p 6379:6379 redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# 6. SQS 큐 URL 8개 (운영 큐 URL을 넣지 않는다. 로컬이 운영 메시지를 소비하게 됨)
# AUTOBIOGRAPHY_TRIGGER, AUTOBIOGRAPHY_CYCLE_INIT, INTERVIEW_SUMMARY 3개가 모두 있어야 consumer가 시작된다
SQS_QUEUE_URL_AUTOBIOGRAPHY_TRIGGER=http://localhost:4566/000000000000/autobiography-trigger
SQS_QUEUE_URL_AUTOBIOGRAPHY_CYCLE_INIT=http://localhost:4566/000000000000/autobiography-cycle-init
SQS_QUEUE_URL_AUTOBIOGRAPHY_RESULT=http://localhost:4566/000000000000/autobiography-result
SQS_QUEUE_URL_AUTOBIOGRAPHY_CYCLE_MERGE=http://localhost:4566/000000000000/autobiography-cycle-merge
SQS_QUEUE_URL_INTERVIEW_SUMMARY=http://localhost:4566/000000000000/interview-summary
SQS_QUEUE_URL_INTERVIEW_SUMMARY_RESULT=http://localhost:4566/000000000000/interview-summary-result
SQS_QUEUE_URL_INTERVIEW_META=http://localhost:4566/000000000000/interview-meta
SQS_QUEUE_URL_AI_PERSISTENCE=http://localhost:4566/000000000000/ai-persistence

# 7. AWS (로컬 전용. 운영은 EC2 인스턴스 역할을 쓰므로 운영 .env에는 없다)
# SQS, Polly(TTS), Transcribe(STT)에 쓰인다. 둘 중 하나만 설정한다.
AWS_REGION=ap-northeast-2
# AWS_PROFILE=talktobook
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
